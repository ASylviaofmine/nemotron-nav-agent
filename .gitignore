__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Recorded artefacts. The video and the GIF are committed on purpose --
# the demo is part of the submission, and a judge should be able to watch
# the run without installing anything.
#
# Regenerate with:
#   python tools/make_demo.py --gif docs/submission.gif
#   python main.py run --gif
docs/*.mp4
docs/*.gif
docs/*.zip
!docs/submission.mp4
!docs/submission.gif
!docs/demo.gif
!docs/nemotron-nav-agent-submission.zip

# Evaluation output
results/
*.log
.DS_Store
.vscode/

# PyCharm. The per-machine .idea/ folder stays out of the repository, but
# the shared run configurations in .run/ are committed on purpose: they
# are the "how do I run this" documentation, and they work in any IDE
# that reads .run/*.xml.
.idea/
!.run/
