__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Recorded artefacts. The demo GIF is committed on purpose -- the video
# is part of the submission, and a judge should be able to see the run
# without installing anything. Regenerate with: python main.py run --gif
docs/*.mp4
!docs/demo.gif

# Evaluation output
results/
*.log
.DS_Store
.vscode/

# PyCharm. The per-machine .idea/ folder stays out of the repository, but
# the shared run configurations in .run/ are committed on purpose: they
# are the "how do I run this" documentation, and they work in any IDE
# that reads .run/*.xml.
.idea/
!.run/
